{
  "name": "smart-fabrication",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fabrication catalog, CRM and workshop operations in one Next.js application",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:measurement-browser": "node --env-file=.env.local scripts/test-measurement-browser.mjs",
    "test:auth": "node --env-file=.env.local scripts/test-authenticated.mjs",
    "test:sessions": "node --experimental-strip-types --env-file=.env.local scripts/test-sessions.mjs",
    "test:concurrency": "node --env-file=.env.local scripts/test-concurrency.mjs",
    "test:load": "node scripts/test-local-load.mjs",
    "test:restore": "node --env-file=.env.local scripts/test-restore.mjs",
    "test:restore:offline": "node scripts/test-offline-restore.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "api:check": "node scripts/check-api.mjs",
    "api:generate": "node --experimental-strip-types scripts/generate-api.ts",
    "db:inspect": "node --env-file=.env.local scripts/db-inspect.mjs",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "test:db": "node --env-file=.env.local scripts/test-database.mjs",
    "owner:grant": "node --env-file=.env.local scripts/grant-owner.mjs",
    "security:check": "node scripts/check-secrets.mjs",
    "api:types": "openapi-typescript docs/api/openapi.yaml -o src/contracts/generated-api.d.ts",
    "db:document": "node --env-file=.env.local scripts/document-database.mjs",
    "test:media": "node --env-file=.env.local scripts/test-media.mjs",
    "test:media-browser": "node --env-file=.env.local scripts/test-media-browser.mjs",
    "test:notifications-browser": "node --env-file=.env.local scripts/test-notifications-browser.mjs",
    "test:reliability-browser": "node --env-file=.env.local scripts/test-reliability-browser.mjs",
    "test:migrations": "node scripts/test-clean-migrations.mjs",
    "test:mobile-client": "node --env-file=.env.local scripts/test-mobile-client.mjs",
    "media:review": "node --env-file=.env.local scripts/media-retention-report.mjs",
    "calc:review": "node --env-file=.env.local scripts/check-calculation-readiness.mjs",
    "test:procurement-browser": "node --env-file=.env.local scripts/test-procurement-browser.mjs",
    "test:publication-browser": "node --env-file=.env.local scripts/test-publication-browser.mjs",
    "test:crm-browser": "node --env-file=.env.local scripts/test-crm-browser.mjs",
    "test:quotation-browser": "node --env-file=.env.local scripts/test-quotation-browser.mjs",
    "test:orders-browser": "node --env-file=.env.local scripts/test-orders-browser.mjs",
    "test:materials-bom": "node --env-file=.env.local scripts/test-materials-bom-browser.mjs",
    "test:inventory": "node --env-file=.env.local scripts/test-inventory-browser.mjs",
    "test:labour-production": "node --env-file=.env.local scripts/test-labour-production-browser.mjs",
    "test:delivery-installation": "node --env-file=.env.local scripts/test-delivery-installation-browser.mjs",
    "test:finance": "node --env-file=.env.local scripts/test-finance-browser.mjs",
    "test:reporting-audit": "node --env-file=.env.local scripts/test-reporting-audit-browser.mjs",
    "seed:website": "node --env-file=.env.local scripts/seed-customer-website.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@react-pdf/renderer": "^4.3.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.76.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.0.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.16.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4",
    "yaml": "^2.8.0"
  }
}
